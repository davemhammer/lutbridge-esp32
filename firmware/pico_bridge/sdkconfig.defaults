# Target: ESP32-C6 "Super Mini" (4 MB flash, native USB serial/JTAG)
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Zigbee: ESP Zigbee SDK v2 API, router, native 802.15.4 radio
CONFIG_ZB_ENABLED=y
CONFIG_ZB_SDK_1xx=n
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_NATIVE=y
